#!/usr/bin/env bash
# Starts every prerequisite of a Makefile target (default: dev) as a window of a
# background tmux session, and lets you (or a coding agent) inspect and control it.
# View and control them in Raycast "Dev Services". Run `makedeck help` for usage.
set -euo pipefail

# Dedicated tmux server for dev services; must match SOCKET in raycast/src/tmux.ts.
SOCKET="${MAKEDECK_SOCKET:-makedeck}"

notify() {
  osascript -e "display notification \"$1\" with title \"makedeck\"" >/dev/null 2>&1 || true
}
# For the start path, which usually runs from a hidden Zed task: also notify.
fail() {
  echo "$1" >&2
  notify "$1"
  exit 1
}
# For the subcommands, which run in a terminal or from an agent: stderr only.
die() {
  echo "$1" >&2
  exit 1
}
# -u: without a UTF-8 locale, tmux replaces the tab separators in -F formats with "_".
t() { tmux -u -L "$SOCKET" "$@"; }

usage() {
  cat <<'EOF'
Usage: makedeck [target]                start the prerequisites of target (default: dev)
       makedeck status                  one line per service: running, stopped, exited (0), failed (N)
       makedeck logs <service> [-n N]   last N lines of a service (default 100)
       makedeck restart [service]       restart one service, or all
       makedeck stop [service]          stop one service, or all (then runs make dev-stop)
       makedeck hook                    Claude Code PreToolUse hook (reads JSON on stdin)
       makedeck help                    this text

status, logs, restart and stop use the session whose project folder contains the
current directory. These names are reserved and cannot be started as targets.
EOF
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || "$1" "tmux is missing. Install it with: brew install tmux"
}

# "dev: frontend backend ## comment" -> "frontend backend", without the "##" comment.
prereqs() {
  awk -v target="$2" '
    $0 ~ "^" target "[[:space:]]*:" {
      sub("^" target "[[:space:]]*:", "");
      sub(/##.*/, "");
      $1 = $1;
      print;
      exit
    }
  ' "$1"
}

# Prints the session whose project folder is $PWD or its nearest parent.
find_session() {
  local sessions dir name path
  if ! sessions=$(t list-sessions -F '#{session_name}	#{session_path}' 2>&1); then
    # No server running counts as no session.
    grep -Eq 'no server running|error connecting to' <<<"$sessions" || die "$sessions"
    sessions=""
  fi
  dir=$PWD
  while :; do
    while IFS=$'\t' read -r name path; do
      if [ -n "$name" ] && [ "$path" = "$dir" ]; then
        echo "$name"
        return 0
      fi
    done <<<"$sessions"
    [ "$dir" = / ] && break
    dir=$(dirname "$dir")
  done
  die "No makedeck session for $PWD. Start it with: makedeck"
}

window_names() {
  t list-windows -t "=$1" -F '#{window_name}' | paste -sd' ' -
}

# Prints the window id (@N) of service $2 in session $1.
window_id() {
  local id
  id=$(t list-windows -t "=$1" -F '#{window_id}	#{window_name}' | awk -F '\t' -v n="$2" '$2 == n { print $1; exit }')
  [ -n "$id" ] || die "No service '$2' in $1. Services: $(window_names "$1")"
  echo "$id"
}

# Same wording as statusText() in raycast/src/services.tsx.
print_status() {
  local name dead code status
  t list-windows -t "=$1" -F '#{window_name}	#{pane_dead}	#{pane_dead_status}' |
    while IFS=$'\t' read -r name dead code; do
      if [ "$dead" != 1 ]; then
        status=running
      elif [ -z "$code" ]; then
        status=stopped # killed by a signal
      elif [ "$code" = 0 ]; then
        status="exited (0)"
      else
        status="failed ($code)"
      fi
      printf '%-16s %s\n' "$name" "$status"
    done
}

cmd_status() {
  [ $# -eq 0 ] || die "Usage: makedeck status"
  require_tmux die
  local session
  session=$(find_session)
  print_status "$session"
}

cmd_logs() {
  local n=100 service=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -n)
        [ $# -ge 2 ] || die "Usage: makedeck logs <service> [-n N]"
        n=$2
        shift 2
        ;;
      *)
        [ -z "$service" ] || die "Usage: makedeck logs <service> [-n N]"
        service=$1
        shift
        ;;
    esac
  done
  [ -n "$service" ] || die "Usage: makedeck logs <service> [-n N]"
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "-n needs a positive number, got '$n'"
  require_tmux die
  local session id
  session=$(find_session)
  id=$(window_id "$session" "$service")
  # -J joins wrapped lines, -S -N includes N lines of history. The visible screen
  # below the last output is blank, so drop trailing blank lines before the tail.
  t capture-pane -p -J -S "-$n" -t "$id" |
    awk '{ line[NR] = $0 } /[^[:space:]]/ { last = NR } END { for (i = 1; i <= last; i++) print line[i] }' |
    tail -n "$n"
}

# Closing or respawning a window in tmux does not reliably end its processes; they keep
# running under PID 1. Each pane process leads its own process group, so SIGTERM to the
# group also reaches children, "&" and nohup processes. Exited panes have no PID and are
# skipped. Anything still running after 5 s gets SIGKILL.
# Mirrors terminate() in raycast/src/tmux.ts; keep both in sync.
# Usage: terminate <list-panes target args>, e.g. terminate -t @3 or terminate -s -t =proj
terminate() {
  local pids=() pid
  while read -r pid; do
    # kill -- -0 would hit our own process group, kill -- -1 every process of the user.
    if [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ]; then pids+=("$pid"); fi
  done < <(t list-panes "$@" -F '#{pane_pid}')
  for pid in ${pids[@]+"${pids[@]}"}; do kill -TERM -- "-$pid" 2>/dev/null || true; done
  wait_for_exit 50 "$@" && return 0
  for pid in ${pids[@]+"${pids[@]}"}; do kill -KILL -- "-$pid" 2>/dev/null || true; done
  wait_for_exit 20 "$@" || die "Processes are still running after SIGKILL"
}

# The pane process can exit while a child that ignores SIGTERM keeps running in its
# group, so wait for the groups themselves, not only for the panes to be dead.
# Usage: wait_for_exit <polls of 0.1 s> <list-panes target args>; reads pids from terminate.
wait_for_exit() {
  local polls=$1 pid alive
  shift
  while :; do
    alive=""
    for pid in ${pids[@]+"${pids[@]}"}; do
      if kill -0 -- "-$pid" 2>/dev/null; then alive=1; break; fi
    done
    if [ -z "$alive" ] && ! t list-panes "$@" -F '#{pane_dead}' | grep -qx 0; then return 0; fi
    [ "$polls" -gt 0 ] || return 1
    polls=$((polls - 1))
    sleep 0.1
  done
}

cmd_restart() {
  [ $# -le 1 ] || die "Usage: makedeck restart [service]"
  require_tmux die
  local session ids id names
  session=$(find_session)
  if [ $# -eq 1 ]; then
    ids=$(window_id "$session" "$1")
    terminate -t "$ids"
    names=$1
  else
    ids=$(t list-windows -t "=$session" -F '#{window_id}')
    terminate -s -t "=$session"
    names=$(window_names "$session")
  fi
  for id in $ids; do t respawn-window -k -t "$id"; done
  echo "restarted $names"
}

# Runs make dev-stop in $1 if make knows the target (it may come from an included file).
run_dev_stop() {
  local out err rc=0
  err=$(mktemp /tmp/makedeck-stop.XXXXXX)
  # LC_ALL=C keeps make's message unlocalized, and without an inherited MAKELEVEL the
  # top-level make reports as "make:", not "make[1]:".
  out=$(cd "$1" && env -u MAKELEVEL LC_ALL=C make dev-stop 2>"$err") || rc=$?
  local stderr
  stderr=$(cat "$err")
  rm -f "$err"
  [ "$rc" -eq 0 ] && { echo "ran make dev-stop"; return 0; }
  # Same rule as isMissingTarget() in raycast/src/tmux.ts: only a top-level "make:" line
  # means the target is missing; make 3.81 quotes with `dev-stop', newer versions with 'dev-stop'.
  if grep -Eq "^make: \*\*\* No rule to make target [\`']dev-stop'" <<<"$stderr"; then return 0; fi
  [ -z "$out" ] || echo "$out" >&2
  [ -z "$stderr" ] || echo "$stderr" >&2
  exit "$rc"
}

cmd_stop() {
  [ $# -le 1 ] || die "Usage: makedeck stop [service]"
  require_tmux die
  local session id path
  session=$(find_session)
  if [ $# -eq 1 ]; then
    id=$(window_id "$session" "$1")
    terminate -t "$id"
    echo "stopped $1"
    return 0
  fi
  path=$(t display-message -p -t "=$session" '#{session_path}')
  terminate -s -t "=$session"
  t kill-session -t "=$session"
  echo "stopped $session"
  run_dev_stop "$path"
}

cmd_start() {
  local target="${1:-dev}"
  [ -f Makefile ] || fail "No Makefile in the current directory."
  require_tmux fail

  local list
  list=$(prereqs Makefile "$target")
  [ -n "$list" ] || fail "Target '$target' has no prerequisites in the Makefile."

  # Session = project folder; tmux does not allow '.' or ':' in session names.
  local session
  session=$(basename "$PWD" | tr '.:' '__')
  if t has-session -t "=$session" 2>/dev/null; then
    echo "$session is already running."
    print_status "$session"
    notify "$session is already running."
    exit 0
  fi

  # Server options apply from the first start: exited processes stay visible as a
  # window so Raycast can show their exit code and output. The empty format drops
  # tmux's "Pane is dead" line from the log; Raycast shows the status anyway.
  CONF=$(mktemp /tmp/makedeck-tmux.XXXXXX)
  trap 'rm -f "$CONF"' EXIT
  printf 'set -g remain-on-exit on\nset -g remain-on-exit-format ""\nset -g history-limit 20000\n' > "$CONF"

  # shellcheck disable=SC2086 # split the list into words on purpose
  set -- $list
  local count=$#
  t -f "$CONF" new-session -d -s "$session" -n "$1" -c "$PWD" -x 200 -y 50 "make $1"
  shift
  for p in "$@"; do
    t new-window -d -t "=$session:" -n "$p" -c "$PWD" "make $p"
  done

  echo "$session: started $count services ($list)"
  notify "$session: started $count services"
}

# Splits the shell command on stdin into segments at ; && || | & ( ) and newlines, and
# each segment into words, honoring quotes and backslashes. Heredoc bodies are text, not
# commands, and are skipped. Prints one segment per line with the words separated by \037,
# a line "\036(" or "\036)" where a subshell starts or ends, and a last line "\036bg" if a
# lone "&" (not part of &&, >& or &>) puts something in the background.
# Runs in linear time: macOS awk counts UTF-8 characters from the start of the string on
# every substr(), so the command is split into an array of bytes once. Words and heredoc
# lines are capped at MAXWORD bytes; no command name, path, make target or heredoc delimiter
# is longer, and growing a huge quoted string byte by byte would take quadratic time.
split_command() {
  awk '
    function add(c) { if (wlen < MAXWORD) { word = word c; wlen++ } in_word = 1 }
    function add_heredoc(delim, dash) { nh++; hdelim[nh] = delim; hdash[nh] = dash }
    function end_word(   rest, dash) {
      if (in_word) {
        # "<<EOF", "<<-'EOF'" or "<<" followed by the delimiter word; not "<<<".
        if (want_delim) { add_heredoc(word, want_dash); want_delim = 0 }
        else if (word ~ /^[0-9]*<</ && word !~ /^[0-9]*<<</) {
          rest = word; sub(/^[0-9]*<</, "", rest)
          dash = substr(rest, 1, 1) == "-"
          if (dash) rest = substr(rest, 2)
          if (rest == "") { want_delim = 1; want_dash = dash } else add_heredoc(rest, dash)
        }
        printf "%s%s", (nw == 0 ? "" : "\037"), word; nw++
      }
      word = ""; wlen = 0; in_word = 0
    }
    # Called at the newline that ends a command line: skips the bodies of its heredocs,
    # leaving i at the newline after the last delimiter line.
    function skip_heredocs(   h, line, len) {
      for (h = 1; h <= nh; h++) {
        while (i < n) {
          line = ""; len = 0; i++
          if (hdash[h]) while (i <= n && ch[i] == "\t") i++
          for (; i <= n && ch[i] != "\n"; i++) if (++len <= MAXWORD) line = line ch[i]
          if (len <= MAXWORD && line == hdelim[h]) break
        }
      }
      nh = 0
    }
    function end_seg() {
      end_word()
      if (nw > 0) printf "\n"
      nw = 0
    }
    BEGIN {
      MAXWORD = 4096; n = 0; q = ""; bg = 0
      while ((getline line) > 0) {
        if (lines++) ch[++n] = "\n"
        m = split(line, part, "")
        for (k = 1; k <= m; k++) ch[++n] = part[k]
      }
      for (i = 1; i <= n; i++) {
        c = ch[i]
        if (c == "\n" && q != "") c = " "
        if (q == "\047") {
          if (c == "\047") q = ""; else add(c)
          continue
        }
        if (q == "\"") {
          if (c == "\\" && i < n) { i++; add(ch[i]) }
          else if (c == "\"") q = ""
          else add(c)
          continue
        }
        if (c == "\\" && i < n) { i++; add(ch[i]); continue }
        if (c == "\047" || c == "\"") { q = c; in_word = 1; continue }
        if (c == " " || c == "\t") { end_word(); continue }
        if (c == "&") {
          if (ch[i + 1] == "&") { i++; end_seg(); continue }
          if (ch[i + 1] == ">" || (i > 1 && ch[i - 1] == ">")) { add(c); continue }
          bg = 1; end_seg(); continue
        }
        if (c == "|" || c == ";" || c == "(" || c == ")" || c == "\n") {
          if (c == "|" && ch[i + 1] == "|") i++
          end_seg()
          if (c == "(" || c == ")") print "\036" c
          if (c == "\n" && nh > 0) skip_heredocs()
          continue
        }
        add(c)
      }
      end_seg()
      if (bg) print "\036bg"
    }
  '
}

# Resolves directory $2 relative to $1 (logical path, like the shell).
resolve_dir() {
  local d=$2
  case "$d" in
    "~") d=$HOME ;;
    "~/"*) d="$HOME/${d#"~/"}" ;;
  esac
  case "$d" in /*) ;; *) d="$1/$d" ;; esac
  (CDPATH='' cd "$d" 2>/dev/null && pwd) || echo "$d"
}

# Claude Code PreToolUse hook: blocks Bash commands that start the dev services
# (make dev, or a prerequisite of dev in the background) of a makedeck project.
# Exit 0 allows, exit 2 blocks with the message on stderr. Input that is not a Bash tool
# call it can read is allowed.
cmd_hook() {
  command -v jq >/dev/null 2>&1 || die "makedeck hook needs jq"
  local input tool cwd bg command
  input=$(cat)
  tool=$(jq -r '.tool_name // ""' <<<"$input" 2>/dev/null) || exit 0
  [ "$tool" = Bash ] || exit 0
  command=$(jq -r '.tool_input.command // ""' <<<"$input" 2>/dev/null) || exit 0
  [[ "$command" == *make* ]] || exit 0
  cwd=$(jq -r '.cwd // ""' <<<"$input")
  [ -n "$cwd" ] || cwd=$PWD
  bg=$(jq -r '.tool_input.run_in_background // false' <<<"$input")

  local segments line dir=$cwd depth=0 saved=()
  segments=$(split_command <<<"$command")
  grep -qx $'\036bg' <<<"$segments" && bg=true

  local w i n word mdir a targets list target found dry prefix
  while IFS= read -r line; do
    case "$line" in
      "" | $'\036bg') continue ;;
      # A subshell gets a copy of the directory; a cd inside it ends with it.
      $'\036(') depth=$((depth + 1)); saved[depth]=$dir; continue ;;
      $'\036)')
        if [ "$depth" -gt 0 ]; then dir=${saved[depth]}; depth=$((depth - 1)); fi
        continue
        ;;
    esac
    IFS=$'\037' read -r -a w <<<"$line"
    n=${#w[@]}
    i=0
    # Skip VAR=value words and command prefixes.
    while [ "$i" -lt "$n" ]; do
      word=${w[$i]}
      if [[ "$word" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
        i=$((i + 1))
      elif [ "$word" = rtk ] && [ "${w[$((i + 1))]:-}" = proxy ]; then
        i=$((i + 2))
      else
        case "$word" in
          nohup | exec | command | time | env | setsid | rtk) i=$((i + 1)) ;;
          *) break ;;
        esac
      fi
    done
    [ "$i" -lt "$n" ] || continue
    word=${w[$i]}
    if [ "$word" = cd ]; then
      case "${w[$((i + 1))]:-}" in
        "") dir=$HOME ;;
        -) ;;
        *) dir=$(resolve_dir "$dir" "${w[$((i + 1))]}") ;;
      esac
      continue
    fi
    case "${word##*/}" in make | gmake) ;; *) continue ;; esac

    # Collect the targets of this make.
    mdir=$dir
    targets=()
    dry=""
    i=$((i + 1))
    while [ "$i" -lt "$n" ]; do
      a=${w[$i]}
      i=$((i + 1))
      case "$a" in
        -C) mdir=$(resolve_dir "$mdir" "${w[$i]:-.}"); i=$((i + 1)) ;;
        -C*) mdir=$(resolve_dir "$mdir" "${a#-C}") ;;
        -f | -I | -o | -W) i=$((i + 1)) ;;
        --dry-run | --just-print | --recon | --question) dry=1 ;;
        -*)
          # -n (dry run) and -q (question) run no recipe, also combined as in "-nB".
          # In "-Wn" the n is the argument of -W, as for -C, -f, -I and -o.
          if [[ "$a" =~ ^-[A-Za-z]+$ ]]; then
            prefix=${a%%[nq]*}
            if [ "$prefix" != "$a" ] && [[ "$prefix" != *[CfIoW]* ]]; then dry=1; fi
          fi
          ;;
        *=*) ;;
        *)
          if [[ "$a" =~ ^[0-9]+$ ]]; then continue; fi
          # Redirections: "> file", "2>&1", "&> log", ">log".
          if [[ "$a" =~ ^(&|[0-9]*)[\<\>]+[\&\|]?$ ]]; then i=$((i + 1)); continue; fi
          if [[ "$a" =~ ^(&|[0-9]*)[\<\>] ]]; then continue; fi
          targets+=("$a")
          ;;
      esac
    done

    [ -z "$dry" ] || continue
    [ -f "$mdir/Makefile" ] || continue
    list=$(prereqs "$mdir/Makefile" dev)
    [ -n "$list" ] || continue
    found=""
    for target in ${targets[@]+"${targets[@]}"}; do
      if [ "$target" = dev ]; then found=1; fi
      if [ "$bg" = true ] && [[ " $list " == *" $target "* ]]; then found=1; fi
    done
    if [ -n "$found" ]; then
      echo "This project runs its dev services with makedeck (services: $list). Do not start them yourself. Start them with: makedeck (returns immediately, safe if already running). Check: makedeck status. Logs: makedeck logs <service>. After code changes: makedeck restart <service>." >&2
      exit 2
    fi
  done <<<"$segments"
  exit 0
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  hook) shift; cmd_hook "$@" ;;
  help | -h | --help) usage ;;
  *) cmd_start "$@" ;;
esac
