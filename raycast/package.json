{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "devmux",
  "title": "Devmux",
  "description": "See your devmux services with live logs, open them in Terminal, restart or stop them.",
  "icon": "icon.png",
  "author": "seml",
  "license": "MIT",
  "type": "module",
  "commands": [
    {
      "name": "services",
      "title": "Dev Services",
      "description": "All running dev services with live logs",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "test": "node --test src/*.test.ts"
  }
}
